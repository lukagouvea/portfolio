---
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { htmlLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  titulo: string;
  descricao: string;
  // URL da mesma página no outro idioma
  alternativa: string;
  // Card de compartilhamento em /public (1200×630), gerado por scripts/gerar-og.mjs
  imagem?: string;
}

const { lang, titulo, descricao, alternativa, imagem } = Astro.props;
const outro: Lang = lang === 'pt' ? 'en' : 'pt';

// URLs absolutas só existem com SITE_URL definido no build
const site = Astro.site;
const absoluta = (caminho: string) => (site ? new URL(caminho, site).href : undefined);
const urlPagina = absoluta(Astro.url.pathname);
const urlAlternativa = absoluta(alternativa) ?? alternativa;
const urlImagem = imagem ? absoluta(imagem) : undefined;
const locale = { pt: 'pt_BR', en: 'en_US' };
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {urlPagina && <link rel="canonical" href={urlPagina} />}
    {urlPagina && <link rel="alternate" hreflang={htmlLang[lang]} href={urlPagina} />}
    <link rel="alternate" hreflang={htmlLang[outro]} href={urlAlternativa} />
    <meta property="og:site_name" content="Luka Gouvêa" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale[lang]} />
    <meta property="og:locale:alternate" content={locale[outro]} />
    {urlPagina && <meta property="og:url" content={urlPagina} />}
    {
      urlImagem && (
        <>
          <meta property="og:image" content={urlImagem} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={titulo} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={urlImagem} />
        </>
      )
    }
    <meta name="theme-color" content="#0f1512" />
    <script is:inline>
      // Aplica o tema antes de pintar a página, para não piscar.
      (function () {
        var salvo = null;
        try {
          salvo = localStorage.getItem('tema');
        } catch (e) {}
        var tema =
          salvo === 'light' || salvo === 'dark'
            ? salvo
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = tema;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
