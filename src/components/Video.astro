---
// Vídeo curto hospedado no próprio site, com controles e sem autoplay.
// Os textos vêm prontos do MDX de cada idioma.

interface Props {
  src: string;
  poster: string;
  largura: number;
  altura: number;
  titulo: string;
  legenda?: string;
}

const { src, poster, largura, altura, titulo, legenda } = Astro.props;
---

<figure class="video">
  <video
    controls
    preload="none"
    playsinline
    poster={poster}
    width={largura}
    height={altura}
    aria-label={titulo}
    style={`--proporcao: ${largura} / ${altura}`}
  >
    <source src={src} type="video/mp4" />
  </video>
  {legenda && <figcaption>{legenda}</figcaption>}
</figure>

<style>
  .video {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  video {
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
    aspect-ratio: var(--proporcao);
    border-radius: 3px;
    background: #000;
  }

  figcaption {
    font-size: 13px;
    color: var(--muted);
    max-width: 68ch;
  }
</style>
